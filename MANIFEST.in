# Include documentation and metadata files
include README.md
include LICENSE
include requirements.txt
include requirements-dev.txt
include INSTALL.md CHANGELOG.md CONTRIBUTING.md
include docs/async.md docs/client-controls.md docs/compatibility.md
include docs/device-semantics.md docs/feature-reads.md docs/feature-roadmap.md
include docs/protocol.md docs/wireless.md
include docs/read-coverage.md
include docs/web-interface.md
include docs/models.md
recursive-include examples *.py
recursive-include dashboard *.py *.md *.txt *.html *.css *.js
recursive-include dashboard/tests *.cjs
recursive-include tests *.py
recursive-include tools *.py

# Include py.typed marker for type hints
include cudypy/py.typed

# Exclude development and test files
exclude test*.py
exclude .gitignore
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * .DS_Store

